# Copy to .env. docker compose reads this file automatically; for a local run
# without Docker, export these yourself.

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-never-used-to-serve-anything-real-0123456789

DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=console

# Unset it and the project falls back to SQLite, so a clean checkout runs
# with nothing installed but Python.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Behind a load balancer that terminates TLS, set this so Django knows the
# original request was https and stops redirecting in a loop.
DJANGO_SECURE_PROXY_SSL_HEADER=false

# Optional. Leave empty to disable error reporting entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

GUNICORN_WORKERS=3
